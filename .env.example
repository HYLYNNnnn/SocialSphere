# Local mode needs no cloud credentials. An empty JWT_SIGNING_KEY causes a
# private signing key to be generated and persisted in DATA_DIR on first run.
STORAGE_MODE=local
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
FRONTEND_DIR=./public
JWT_SIGNING_KEY=

# Optional AI feature: configure only on the backend, never as REACT_APP_*.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Used only in cloud mode.
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_USER_INDEX=socialsphere_users_v2
ES_POST_INDEX=socialsphere_posts_v2
GCS_BUCKET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
